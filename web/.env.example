# Supabase
# Public — used by the browser and session-bound server clients; subject to RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses RLS entirely. Only used by the ingestion pipeline's
# equivalent web-side callers (the Stripe webhook, admin invite script). Never
# read this in a route that serves a signed-in contractor's request.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Ops
# Comma-separated emails (must match a real Supabase Auth user) allowed to view
# /ops/purchase-orders — these pages name the fulfilling distributor
# explicitly, so this must never overlap with contractor access.
OPS_ADMIN_EMAILS=
